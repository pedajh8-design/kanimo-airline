# ============================================================
# KANIMO AIRLINE TICKETING PLATFORM - ENVIRONMENT VARIABLES
# ============================================================

# Database URL
# Local SQLite default: "file:./dev.db"
# Vercel / Production PostgreSQL (e.g. Supabase, Neon, AWS RDS):
# DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/kanimo?sslmode=require"
DATABASE_URL="file:./dev.db"

# JWT Secret for Session & Bearer token signing
JWT_SECRET="replace_with_strong_random_secret_min_32_chars"

# Digital Ticket Cryptographic Signing Key (HMAC-SHA256)
# Used to sign QR codes and prevent boarding pass forgery
TICKET_SIGNING_SECRET="replace_with_unpredictable_hmac_secret_min_32_chars"

# Payments Configuration
# Set DEMO_PAYMENT_MODE="true" to allow instant checkout testing without live card charges
DEMO_PAYMENT_MODE="true"

# Stripe Production Keys (Required if DEMO_PAYMENT_MODE="false")
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Public Application Base URL (Web & Android backend base)
# e.g., "https://kanimo-airline.vercel.app" or "http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="production"
